{
	"name": "@greatislander/bight.dev",
	"version": "2.0.0-alpha.0",
	"description": "Home of Bight Consulting",
	"main": ".eleventy.js",
	"dependencies": {
		"@11ty/eleventy": "^0.10.0",
		"@11ty/eleventy-plugin-rss": "^1.0.7",
		"@11ty/eleventy-plugin-syntaxhighlight": "^3.0.1",
		"@tbranyen/jsdom": "^13.0.0",
		"concurrently": "^5.1.0",
		"html-minifier": "^4.0.0",
		"modern-css-reset": "^1.0.4",
		"npm-run-all": "^4.1",
		"rimraf": "^3.0",
		"sass": "^1.25.0",
		"slugify": "^1.3.6"
	},
	"devDependencies": {
		"chokidar-cli": "^2.1.0",
		"cross-env": "^7.0.0",
		"make-dir-cli": "^2.0.0",
		"rollup": "^1.31.0",
		"rollup-plugin-commonjs": "^10.1.0",
		"rollup-plugin-json": "^4.0.0",
		"rollup-plugin-node-builtins": "^2.1.2",
		"rollup-plugin-node-resolve": "^5.2.0",
		"stylelint": "^13.3.3",
		"stylelint-config-recommended": "^3.0.0"
	},
	"scripts": {
		"sass": "sass src/scss/global.scss src/_includes/assets/css/global.css --style=compressed",
		"clean": "rimraf dist",
		"cms:precompile": "make-dir dist/admin && nunjucks-precompile src/_includes > dist/admin/templates.js -i '\\.(njk|css|svg)$'",
		"cms:bundle": "rollup --config",
		"lint:css": "stylelint src/scss/**/*.scss",
		"lint": "run-s lint:*",
		"start": "npm run clean && concurrently 'npm run sass -- --watch' 'npm run cms:bundle -- --watch' 'chokidar \"src/_includes/**\" -c \"npm run cms:precompile\"' 'npm run serve'",
		"serve": "cross-env ELEVENTY_ENV=development npx eleventy --serve",
		"production": "run-s clean sass cms:* && npx eleventy",
		"test": "npm run lint"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/andybelldesign/hylia.git"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/andybelldesign/hylia/issues"
	},
	"homepage": "https://github.com/andybelldesign/hylia#readme"
}
